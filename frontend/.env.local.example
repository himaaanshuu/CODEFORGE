# CodeForge AI - frontend environment example
# Copy to .env.local (gitignored) and fill in your values.
#
# VITE_* variables are exposed to the browser bundle — never put secrets
# (service accounts, private keys, server API keys) here.

# Backend API origin (no trailing slash required; /api suffix included)
VITE_API_BASE=http://localhost:8000/api/v1

# Supabase project config (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
