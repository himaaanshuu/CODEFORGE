# CodeForge AI - Environment Configuration
# Copy this file to .env and fill in your values (backend/.env is gitignored).

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Agent model picker (Ultra = default reasoning model, Super/Nano = faster, cheaper)
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
DEBUG=False

# Supabase (backend verifies access tokens + PostgREST storage)
# Without these, protected routes fail closed with HTTP 503 and run
# persistence is unavailable — authentication is never silently bypassed.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated CORS origins for the frontend (default: localhost:5173)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
